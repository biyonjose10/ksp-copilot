# Copy to .env and fill in. docker-compose reads these from the shell environment or .env.

# One key is required for the LLM steps (router, synthesis, Kannada translation).
# Anthropic is preferred; Gemini (free tier) is the fallback when it is the only key set.
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# Optional — defaults.
ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash

# Local (non-Docker) runs only. Docker Compose sets this to the db service automatically.
DATABASE_URL=postgresql://ksp:ksp@localhost:5432/ksp

# Copy to .env and fill in. docker-compose reads ANTHROPIC_* from the shell environment.

# Required for the LLM steps (router, synthesis, Kannada translation).
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Local (non-Docker) runs only. Docker Compose sets this to the db service automatically.
DATABASE_URL=postgresql://ksp:ksp@localhost:5432/ksp
